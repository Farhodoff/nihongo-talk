{
    "buildCommand": "npm run build",
    "outputDirectory": "build",
    "devCommand": "npm run dev",
    "installCommand": "npm install --legacy-peer-deps",
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/sw.js", "destination": "/sw.js" },
        { "source": "/workbox-(.*).js", "destination": "/workbox-$1.js" },
        { "source": "/((?!api/|sw\\.js|workbox-).*)", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(self), microphone=(self), display-capture=(self)"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(favicon\\.svg|logo\\.png|apple-touch-icon\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/((?!assets/|favicon\\.svg|logo\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ]
}